# Local development only. Production values live in GitHub Actions secrets/variables and
# Vercel environment variables — never in this repository. Copy to .env for local runs.

# --- Database -------------------------------------------------------------------
# Local: SQLite file. Production: Supabase SESSION pooler (port 5432, supports the advisory
# lock), e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///data/dev.db

# --- Mode -------------------------------------------------------------------------
DRY_RUN=true
CHANNEL_NAME=AI-новости (рабочее название)

# --- Telegram (separate bot + channel for this project) ----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TARGET=telegram:main

# --- LLM ----------------------------------------------------------------------------
LLM_PROVIDER=gemini
# Key from https://aistudio.google.com/apikey — use a NEW Google Cloud project so this
# project's free quota is separate from any other project's.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_THINKING_LEVEL=
# Free backup provider (Groq, OpenAI-compatible) used only when all Gemini models are busy.
GROQ_API_KEY=
EMBED_DIMS=256
# Quota guard (per Pacific-time day = Gemini's reset). A request limit, not a euro limit.
LLM_DAILY_REQUEST_LIMIT=150
LLM_DAILY_EMBED_REQUEST_LIMIT=60
LLM_MIN_INTERVAL_SECONDS=4
LLM_MAX_RETRIES=3

# --- Editorial -------------------------------------------------------------------------
PUBLISH_THRESHOLD=55
MAJOR_THRESHOLD=70
MAIN_THRESHOLD=80
MAX_ITEM_AGE_HOURS=36
STORY_WINDOW_HOURS=60
PUBLISH_MAX_AGE_HOURS=30
MAX_COMPOSE_PER_CYCLE=15

# --- Dedup -----------------------------------------------------------------------------
EMBED_MERGE_STRONG=0.93
EMBED_MERGE_GRAY=0.86

# --- Weekly ------------------------------------------------------------------------------
WEEKLY_TIMEZONE=Europe/Helsinki
WEEKLY_PUBLISH_WEEKDAY=0
WEEKLY_PUBLISH_HOUR=9
WEEKLY_MIN_IMPORTANCE=50

# --- Dashboard (Vercel) ----------------------------------------------------------------------
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Read-only role created by `ainews grant-dashboard` (password from DASHBOARD_DB_PASSWORD):
# postgresql://newsbot_dashboard.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DASHBOARD_DATABASE_URL=
